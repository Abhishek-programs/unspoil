{
  "expo": {
    "name": "SpendSense",
    "slug": "SpendSense",
    "owner": "abhishek-programs",
    "scheme": "spendsense",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9aee28c7-b0d7-4d65-95e1-a8763d6362bf"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A34A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.SpendSense"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16A34A"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "androidStatusBar": {
        "barStyle": "dark-content"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SpendSense"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#16A34A"
        }
      ],
      "./plugins/withPaymentWatch.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9aee28c7-b0d7-4d65-95e1-a8763d6362bf"
      }
    }
  }
}
